# Dit bestand bevat alleen veilige voorbeeldwaarden.
# Kopieer het later naar .env; zet nooit echte sleutels in Git.
BROKER_AI_MODE=simulation
BROKER_AI_LOG_LEVEL=INFO
BROKER_AI_API_TOKEN=replace-with-a-long-random-secret
BROKER_AI_DATABASE_PATH=data/broker_ai.db

# Alleen sleutels uit het Alpaca Paper-dashboard gebruiken.
ALPACA_API_KEY_ID=replace-with-paper-key-id
ALPACA_API_SECRET_KEY=replace-with-paper-secret-key
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
